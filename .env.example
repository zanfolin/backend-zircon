# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration (SQLite)
DB_CLIENT=sqlite3
DB_FILENAME=./data/zircon.db

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Configuration (Generic SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="Zircon <noreply@zircon.com>"
EMAIL_VERIFICATION_EXPIRY=10m
PASSWORD_RESET_EXPIRY=1h

# Frontend URLs (for email links)
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_MOBILE_URL=zircon://

# File Upload Configuration
UPLOAD_DIR=./uploads/avatars
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100